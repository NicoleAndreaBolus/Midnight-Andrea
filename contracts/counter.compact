pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * PRIVACY MODEL & ARCHITECTURE
 * ============================
 * PUBLIC LEDGER STATE (On-Chain, visible to everyone):
 *   - `counter`: Uint<64> - The public counter state stored on the Midnight blockchain.
 *
 * PRIVATE WITNESS & INPUTS (Off-Chain, local ZK execution):
 *   - `secretAmount`: Uint<64> - Private witness input passed into the zero-knowledge circuit.
 *     The input is processed privately off-chain by the user's local prover.
 *
 * DELIBERATE DISCLOSURE:
 *   - `disclose(secretAmount)`: Explicitly discloses the computed value to update 
 *     the public ledger `counter` state on-chain.
 */

export ledger counter: Uint<64>;

// Circuit 1: Increment counter using a private witness input
export circuit incrementByPrivateWitness(secretAmount: Uint<64>): [] {
    counter = (counter + disclose(secretAmount)) as Uint<64>;
}

// Circuit 2: Reset counter value
export circuit resetCounter(newValue: Uint<64>): [] {
    counter = disclose(newValue);
}
